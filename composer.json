{
    "name": "beziworld/laravel-autenti",
    "description": "Autenti e-signature API v2 for Laravel: document processes, participants, files, sending, action links, signed file download, JWT bearer auth and JWS-verified callbacks.",
    "keywords": [
        "laravel",
        "autenti",
        "e-signature",
        "electronic-signature",
        "podpis-elektroniczny",
        "eidas",
        "documents",
        "poland"
    ],
    "homepage": "https://github.com/beziworld/laravel-autenti",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-autenti/issues",
        "source": "https://github.com/beziworld/laravel-autenti"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpseclib/phpseclib": "^3.0.43",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\Autenti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\Autenti\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\Autenti\\AutentiServiceProvider"
            ],
            "aliases": {
                "Autenti": "Beziworld\\Autenti\\Facades\\Autenti"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
